# Copy to deploy/.env and adjust. Used by docker-compose.dev.yml and docker-compose.prod.yml.

# --- Public hosts (prod nginx; examples only) ---
LANDING_HOST=landing.example.com
APP_HOST=app.example.com
DOCS_HOST=docs.example.com
API_HOST=api.example.com
ORCHESTRATOR_HOST=orchestrator.example.com
PREVIEW_HOST=preview.example.com

# Dev edge (path-based routing on one host)
DEV_HTTP_PORT=8080
# Host port for PostgreSQL (connect from your machine: localhost:5432)
DEV_POSTGRES_PORT=5432
# Host port for the bundled dev k3s cluster's API server (kubectl/Helm from
# your machine: localhost:6443 — see orchestrator/docs/overview/setup.md)
DEV_K3S_PORT=6443
# Host port for the Kubernetes dashboard (Headlamp), viewing the bundled dev
# k3s cluster at http://localhost:4466
DEV_K8S_DASHBOARD_PORT=4466
# Host ports for the bundled dev k3s cluster's Traefik ingress — this is how
# you actually reach a project's always-on primary deployment (ADR 003 §15)
# from your machine. Also set orchestrator/.env and api/.env's
# APPS_BASE_DOMAIN=127.0.0.1.nip.io (resolves to 127.0.0.1 with no /etc/hosts
# edits) and api/.env's APPS_HTTPS_PORT to match DEV_APPS_HTTPS_PORT below —
# see docs/conventions/deploy.md.
DEV_APPS_HTTP_PORT=8090
DEV_APPS_HTTPS_PORT=8443

# --- PostgreSQL ---
POSTGRES_USER=yggdrasil
POSTGRES_PASSWORD=change-me
POSTGRES_DB=yggdrasil

# --- MinIO (S3-compatible) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=yggdrasil

# --- App URLs (passed to services) ---
# Dev: leave defaults; nginx serves path-based routes on localhost
API_PUBLIC_URL=http://localhost:8080/api
APP_PUBLIC_URL=http://localhost:8080/app
DOCS_PUBLIC_URL=http://localhost:8080/docs
LANDING_PUBLIC_URL=http://localhost:8080
ORCHESTRATOR_PUBLIC_URL=http://localhost:8080/orchestrator

# Orchestrator (internal + public edge)
ORCHESTRATOR_URL=http://orchestrator:8080
ORCHESTRATOR_PORT=8080

# API service
API_PORT=3000
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=${MINIO_ROOT_USER}
S3_SECRET_KEY=${MINIO_ROOT_PASSWORD}
S3_BUCKET=${MINIO_BUCKET}
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Next.js apps (path prefixes behind dev nginx)
WEB_BASE_PATH=/app
WEB_API_BASE_URL=/api
LANDING_BASE_PATH=
DOCS_BASE_URL=/docs/
DOCS_SITE_URL=http://localhost:8080
