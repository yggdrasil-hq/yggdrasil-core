# Rendered at container start via envsubst (nginx official image templates/).
# TLS is terminated upstream; trust X-Forwarded-* from your proxy/CDN.

upstream landing_upstream {
    server landing:3000;
}

upstream web_upstream {
    server web:3000;
}

upstream docs_upstream {
    server docusaurus:3000;
}

upstream api_upstream {
    server api:3000;
}

upstream orchestrator_upstream {
    server orchestrator:8080;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Landing
server {
    listen 80;
    server_name ${LANDING_HOST};

    client_max_body_size 50m;

    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    location / {
        proxy_pass http://landing_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }
}

